<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.dated-book</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.claude/plugins/mirai-station/runtime/scripts/run-dated-book.sh</string>
  </array>

  <!-- DATED BOOK SIDECAR: nightly far-dated OI pull (next two SPX monthlies +
       quarter-end EOM), display-only. Two fires:
         * daily 05:17 PT == 08:17 ET, pre-open after overnight OI settles;
         * Friday 14:10 PT == 17:10 ET — fires EVERY Friday (launchd cannot
           express "third Friday"); only the OpEx one matters, when python
           rolls past the just-settled monthly to the new fronts; the other
           Fridays are cheap re-pulls of the same fronts.
       NOTE: launchd's StartCalendarInterval uses SYSTEM-LOCAL time and ignores
       the TZ env var below (that only scopes the spawned process). This box
       runs on Pacific, so Hour=5 == 05:00 PT == 08:00 ET year-round. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>17</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>14</integer>
      <key>Minute</key>
      <integer>10</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.dated-book.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.dated-book.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
