<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.spx-claude-forecast-recorder</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.claude/plugins/mirai-station/runtime/scripts/run-spx-claude-forecast-recorder.sh</string>
  </array>

  <!-- The spx-claude-forecast recorder: copies station data before it is overwritten or deleted, and
       mirrors the forecast folder off-disk. Fires at 08:40 ET (after the 08:17 ET dated-book fetch),
       16:25 ET (after the close: the day's $VIX1D close, the raw tape, SPX 5-minute bars from Schwab)
       and Friday 17:30 ET (after the Friday 17:10 ET book refresh). Every task copies only what is
       missing. Reads every station store read-only; writes only under state/spx_claude_forecast/.
       NOTE: launchd's StartCalendarInterval uses SYSTEM-LOCAL time and ignores the TZ env var below.
       This box runs on Pacific, so Hour=5 Minute=40 == 05:40 PT == 08:40 ET year-round. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.spx-claude-forecast-recorder.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.spx-claude-forecast-recorder.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
