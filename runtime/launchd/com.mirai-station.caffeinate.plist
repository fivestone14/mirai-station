<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.caffeinate</string>

  <!-- Keep the Mac mini awake; -i prevents idle sleep, -m prevents disk sleep,
       -s prevents system sleep on AC power, -u declares user activity. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-imsu</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.caffeinate.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.caffeinate.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
