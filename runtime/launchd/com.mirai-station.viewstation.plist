<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.viewstation</string>

  <!-- Long-running read-only HTTP server for the tablet view. Unlike the tick
       jobs (StartInterval), this stays up: RunAtLoad + KeepAlive so it restarts
       on crash and at login. The server itself is idle until the tablet polls. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.claude/plugins/mirai-station/runtime/scripts/run-viewstation.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.viewstation.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.viewstation.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>MIRAI_VIEW_PORT</key>
    <string>8787</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
