<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.auth-watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.claude/plugins/mirai-station/runtime/scripts/run-auth-check.sh</string>
  </array>

  <!-- Schwab login keep-alive. Runs once a day at 8:00 AM ET; if the 7-day token
       is at day 6+ (or unreadable) it pushes a one-tap re-auth link to the phone.
       Cheap no-op on every other day.
       NOTE: launchd's StartCalendarInterval uses SYSTEM-LOCAL time and ignores the
       TZ env var below (that only scopes the spawned process). This box runs on
       Pacific, so Hour=5 == 05:00 PT == 08:00 ET year-round (PT≡ET−3h through DST). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.auth-watch.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.auth-watch.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
