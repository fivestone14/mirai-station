<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#0a0e14" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<title>Mirai Viewstation</title>
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="/icon.svg" type="image/svg+xml" />
<link rel="stylesheet" href="/style.css" />
</head>
<body>
<header id="topbar">
  <div class="brand">
    <span class="logo">🧠</span>
    <div class="brand-text">
      <div class="title">Mirai Awakening</div>
      <div class="subtitle" id="sub">loading…</div>
    </div>
  </div>
  <nav id="tabs">
    <button class="tab" data-view="simple">Overview</button>
    <button class="tab" data-view="deep">Deep</button>
    <button class="tab" data-view="learning">Learning</button>
    <button class="tab" data-view="raw">🗺️ Pipeline</button>
  </nav>
  <div class="status">
    <span id="pulse" class="pulse" title="auto-refresh"></span>
    <span id="updated" class="updated">—</span>
    <button id="refresh" class="refresh" title="refresh now">⟳</button>
  </div>
</header>

<main id="app">
  <div id="loading" class="loading">Connecting to the Mac mini…</div>
  <section class="view" id="view-simple" hidden></section>
  <section class="view" id="view-deep" hidden></section>
  <section class="view" id="view-learning" hidden></section>
  <section class="view" id="view-raw" hidden></section>
</main>

<div id="modal" class="modal" hidden>
  <div class="modal-card">
    <button class="modal-close" id="modal-close">✕</button>
    <div id="modal-body"></div>
  </div>
</div>

<footer id="footer">
  built from live state · plain-English + under-the-hood · read-only · not financial advice
</footer>

<script src="/app.js"></script>
</body>
</html>
