<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device. The app holds a station credential, so its data
     is excluded from cloud backup and from device-to-device transfer: a
     restored copy on another phone would carry the password with it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
