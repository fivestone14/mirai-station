<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.spx-claude-forecast-nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.claude/plugins/mirai-station/runtime/scripts/run-spx-claude-forecast-nightly.sh</string>
  </array>

  <!-- The spx-claude-forecast nightly job: seals what happened after every read of the day, rebuilds the
       library of past moments, scores every forecaster and writes the scorecard. Fires at 17:15 ET on
       weekdays, after the 16:20 ET daily-close save (the official close it grades to_close on) and the
       17:05 ET prediction nightly. Writes only under state/spx_claude_forecast/ and the backup folder.
       NOTE: launchd's StartCalendarInterval uses SYSTEM-LOCAL time and ignores the TZ env var below.
       This box runs on Pacific, so Hour=14 Minute=15 == 14:15 PT == 17:15 ET year-round (PT is ET minus
       3h through DST). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>15</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.spx-claude-forecast-nightly.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.spx-claude-forecast-nightly.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
