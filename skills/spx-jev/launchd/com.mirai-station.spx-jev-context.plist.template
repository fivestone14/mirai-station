<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.spx-jev-context</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.claude/plugins/mirai-station/runtime/scripts/run-spx-jev-context.sh</string>
  </array>

  <!-- The market around SPX, a snapshot a minute during market hours: breadth, the VIX family, the ES
       future, rates, the sectors, the index funds and the big names, appended to
       state/spx_jev/context/{date}.jsonl (spx_jev/market_context.py). One batched quote call and seven
       breadth history calls a run, spaced half a second apart, through the station's shared REST
       client; never the lob-flow streamer. The runner's market gate keeps it to market hours.
       Staged, not installed. -->
  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.spx-jev-context.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.spx-jev-context.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
