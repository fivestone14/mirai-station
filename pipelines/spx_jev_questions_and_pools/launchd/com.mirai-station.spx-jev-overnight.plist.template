<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.spx-jev-overnight</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/mirai_awakening/scheduled_jobs/job_start_scripts/start_job_with_logs.sh spx-jev-overnight run-spx-jev-overnight.sh</string>
  </array>

  <!-- The overnight futures store: /ES, /ZN, /BTC and /MBT 1- and 5-minute bars from the prior close
       to the read, one file per night under data/market/futures_price_bars_by_minute/{date}.jsonl with a line
       in market/futures_price_bar_change_counts_by_save.jsonl for each save that changed a night, and the roll
       table market/futures_contracts_and_past_rolls_latest.json beside them (spx_jev/overnight.py, rolls.py). Fires at 09:26 ET,
       before the open, so the night is on disk for a 09:28 read, and again at 16:20 ET to finish the
       day's session and re-detect the rolls (spx_jev/overnight.py SAVE_TIMES; a test holds these
       entries to them). Market days only; a rerun adds only what is not on disk, and each run
       re-saves the last week's nights, so a missed run is caught up by the next.
       NOTE: launchd's StartCalendarInterval uses SYSTEM-LOCAL time and ignores the
       TZ env var below. This box runs on Pacific, so Hour=6 Minute=26 == 06:26 PT == 09:26 ET
       year-round (PT is ET minus 3h through DST). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>26</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>20</integer></dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
