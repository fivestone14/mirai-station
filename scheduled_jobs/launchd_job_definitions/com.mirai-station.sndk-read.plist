<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.sndk-read</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.claude/plugins/mirai-station/runtime/scripts/run-sndk-read.sh</string>
  </array>

  <!-- The SNDK reading: fire every 2 min, in step with the scanner so it always
       sees the newest diary row, but the MODEL is not called every fire — the
       wake gate (obs-3) spends a call only when something genuinely changed
       since the model last SPOKE: a frozen level crossed, structure holding
       changed for two fresh books, real travel, an IV move on the smoothed
       series, or a 60-minute heartbeat. Replayed over 24 recorded sessions
       that is ~19 calls a day against ~179 scans. DAILY_CALL_CAP=30 in
       sndk_read.py is the hard backstop above that.

       Separate from com.mirai-station.sndk on purpose: a model call can hang to
       its 100s timeout, and it must never be able to eat the scanner's tick and
       cost a diary row. launchd will not run two copies of this at once. -->
  <key>StartInterval</key>
  <integer>120</integer>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.sndk-read.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.sndk-read.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
