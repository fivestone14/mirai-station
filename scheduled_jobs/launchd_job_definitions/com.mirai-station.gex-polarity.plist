<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mirai-station.gex-polarity</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.claude/plugins/mirai-station/runtime/scripts/run-gex-polarity.sh</string>
  </array>

  <!-- After-close GEX polarity + magnet A/B grader (shadow). Runs once a day at
       4:15 PM ET, after the close, so the full session's gex_views/gex_theta
       predictions are graded against the finished 1-min bar path.
       NOTE: launchd's StartCalendarInterval uses SYSTEM-LOCAL time and ignores the
       TZ env var below. This box runs on Pacific, so Hour=13 == 13:15 PT == 16:15 ET
       year-round (PT≡ET−3h through DST). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>13</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/mirai-station.gex-polarity.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mirai-station.gex-polarity.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
